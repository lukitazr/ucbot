# ==============================================================================
# VARIABLES DE ENTORNO PARA UCBOT VERCEL SERVERLESS (HTTP INTERACTIONS)
# ==============================================================================

# Token del bot de Discord (para Discord REST API y deploy-commands)
DISCORD_TOKEN=tu_token_de_discord_aqui

# ID de la aplicación de Discord (Client ID / Application ID)
DISCORD_APPLICATION_ID=tu_application_id_aqui

# Clave pública de la aplicación en Discord Developer Portal (General Information -> Public Key)
# Esta clave es obligatoria para verificar criptográficamente las peticiones enviadas por Discord a Vercel
DISCORD_PUBLIC_KEY=tu_public_key_aqui

# Conexión a la base de datos MongoDB (Atlas)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/ucbot

# Color de los embeds (Hex)
BOT_COLOR=#ffc600

# (Opcional) ID de un servidor de Discord para registrar los Slash Commands instantáneamente en pruebas
# Si se deja vacío, los comandos se registrarán de forma GLOBAL
# DISCORD_DEV_GUILD_ID=123456789012345678
