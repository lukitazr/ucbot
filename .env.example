# Discord Bot
DISCORD_TOKEN=TU_TOKEN_DE_DISCORD_AQUI
PREFIX=uc!
BOT_COLOR=#ffc600

# Base de datos (MongoDB)
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/nombre_db

# Canales
LOGS_CHANNEL_ID=ID_DEL_CANAL_DE_LOGS

# Dueños del bot (IDs separados por coma)
OWNER_IDS=ID_DUEÑO_1,ID_DUEÑO_2

